# Copy to .env and the service reads it at startup -- app/config.py loads this
# file before it reads any setting, and docker-compose.yml passes it through to
# the container. Leave PE_API_KEY empty and the service still runs, proxying the
# keyless PuntersEdge demo endpoints; it logs a warning at startup so a blank
# key in this file is never a silent downgrade.
#
# Free key (1,500 credits/month, no card):
#   https://puntersedge.online/api?utm_source=racing-data-fastapi&utm_medium=code
PE_API_KEY=

# Upstream base. Point this at tools/stub_upstream.py to exercise the 402/429
# error paths locally without touching the real API.
PE_UPSTREAM_BASE=https://api.puntersedge.online/v1

# Cache TTLs in seconds. Raise them to spend fewer credits, lower them for
# fresher prices. See the credit arithmetic in app/cache.py.
CACHE_TTL_RACES=20
CACHE_TTL_BEST_ODDS=60
CACHE_TTL_HISTORY=900

# /v1/racing/next-to-go is not Australia-only. Leave this set unless you want
# Japanese and Hong Kong races in the response.
DEFAULT_COUNTRY=AU

# The other half of the country filter: a race whose meeting is not confirmed
# yet has country=null upstream, and a country filter drops it. Upstream puts
# that at 58.8% of horse races in a measured window. Leave this on unless you
# specifically want confirmed meetings only.
DEFAULT_INCLUDE_UNRESOLVED=true

# Comma-separated sport keys to allow in addition to the snapshot in
# app/routers/best_odds.py, for when PuntersEdge adds a sport.
# PE_EXTRA_SPORT_KEYS=

UPSTREAM_TIMEOUT_S=10
LOG_LEVEL=INFO
