{
    "openapi": "3.1.0",
    "info": {
        "title": "racing-data-fastapi",
        "summary": "A cached, key-custodying FastAPI backend over the PuntersEdge Australian racing and sports odds API.",
        "description": "A reference backend for reading the PuntersEdge odds feed.\n\nRuns without an upstream API key by proxying the keyless demo endpoints. Set `PE_API_KEY` to serve the full feed.\n\nFree key: https://puntersedge.online/api?utm_source=racing-data-fastapi&utm_medium=code",
        "license": {
            "name": "MIT"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/races/next": {
            "get": {
                "tags": [
                    "racing"
                ],
                "summary": "Next races to jump",
                "description": "Upcoming races with every bookmaker price this feed carries, best price per runner precomputed. Serves the keyless PuntersEdge demo sample when no PE_API_KEY is configured, and the full feed when one is.",
                "operationId": "races_next_races_next_get",
                "parameters": [
                    {
                        "name": "country",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "description": "ISO country codes, comma separated. 'any' disables the filter.",
                            "default": "AU",
                            "title": "Country"
                        },
                        "description": "ISO country codes, comma separated. 'any' disables the filter."
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 200,
                            "minimum": 1,
                            "default": 10,
                            "title": "Limit"
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "horse, harness or greyhound. Omit for all.",
                            "title": "Category"
                        },
                        "description": "horse, harness or greyhound. Omit for all."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RacesResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/races/{race_id}/prices": {
            "get": {
                "tags": [
                    "racing"
                ],
                "summary": "Every bookmaker price for one race",
                "description": "Reads the race out of the snapshot /races/next already fetched, so in the common case this route costs zero additional upstream credits.",
                "operationId": "race_prices_races__race_id__prices_get",
                "parameters": [
                    {
                        "name": "race_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "race_id from /races/next",
                            "title": "Race Id"
                        },
                        "description": "race_id from /races/next"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RacePricesResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/races/{race_id}/history": {
            "get": {
                "tags": [
                    "racing"
                ],
                "summary": "Open/close/high/low per runner-bookmaker for a race that has run",
                "description": "Wraps /v1/racing/price-history (5 credits). Requires an upstream key. Upstream returns 404 for a race that has not jumped yet -- history is written once the market has closed, not while it is live.",
                "operationId": "race_history_races__race_id__history_get",
                "parameters": [
                    {
                        "name": "race_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "race_id of a race that has already run",
                            "title": "Race Id"
                        },
                        "description": "race_id of a race that has already run"
                    },
                    {
                        "name": "include_points",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "description": "True returns every recorded point, not just open/close/high/low",
                            "default": false,
                            "title": "Include Points"
                        },
                        "description": "True returns every recorded point, not just open/close/high/low"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PriceHistoryResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/best-odds/{sport}": {
            "get": {
                "tags": [
                    "sports"
                ],
                "summary": "Best available price per selection across bookmakers",
                "description": "Keyed mode calls /v1/best-odds/{sport_key} (3 credits). Keyless mode calls /v1/demo/best-odds (0 credits), which returns a truncated sample.",
                "operationId": "best_odds_best_odds__sport__get",
                "parameters": [
                    {
                        "name": "sport",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Sport key, e.g. afl, nrl, nba",
                            "title": "Sport"
                        },
                        "description": "Sport key, e.g. afl, nrl, nba"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BestOddsResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "ops"
                ],
                "summary": "Liveness, mode and cache state",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
